{
  "experiment_name": "baseline_with_dynamic_padding",
  "seed": 42,
  "dataset_name": "daily_dialog",
  "dataset": {
    "daily_dialog": {
      "num_labels": 7,
      "max_turns": 36
    }
  },
  "bert": {
    "consider_previous_k": 3,
    "freeze_except_last_k": 4,
    "lr": 1e-5,
    "dropout": 0.1,
    "model_name": "bert-base-uncased"
  },
  "attention":{
    "dim": 512,
    "lr": 1e-3,
    "dropout": 0.2
  },
  "head": {
    "lr": 1e-3,
    "dropout": 0.2
  },
  "conversation_head": {
    "lr": 1e-3,
    "dropout": 0.2
  },
  "utterance_recognition": {
    "retrain": true,
    "run": true,
    "epochs": 5,
    "batch_size": 16,
    "model_name": "utterance_classifier",
    "checkpoint_name": "utterance_classifier.pt"
  },
  "conversation_recognition": {
    "run": true,
    "retrain": true,
    "embed_use": 1,
    "epochs": 10,
    "batch_size": 4,
    "bert_freeze_epochs": 3,
    "model_name": "conversation_classifier",
    "checkpoint_name": "conversation_classifier.pt"
  },
  "weight_decay": 0.01,
  "prepare_data_again": 0,
  "compile_model": 0,
  "debug": 0,
  "use_cuda": 0,
  "use_amp": 0,
  "deterministic_run": 1
}